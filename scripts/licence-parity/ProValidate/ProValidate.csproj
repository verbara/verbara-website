<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Validates issued .lic files with the real licence reader and validator.
    Maintainer-only: it builds against a local checkout of the licensing
    validator, passed as the MSBuild property ProDir. Run it through
    ../pro-parity.ts, which sets ProDir and keeps every build output in a
    temporary directory. See ../README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <Target Name="RequireProDir" BeforeTargets="CollectPackageReferences;BeforeBuild">
    <Error Condition="'$(ProDir)' == ''" Text="Set ProDir to a checkout of the licensing validator (pro-parity.ts --pro-dir)." />
    <Error Condition="'$(ProDir)' != '' And !Exists('$(ProDir)/src/Verbara.Sdk.Pro.Licensing/Verbara.Sdk.Pro.Licensing.csproj')" Text="ProDir '$(ProDir)' does not contain src/Verbara.Sdk.Pro.Licensing/Verbara.Sdk.Pro.Licensing.csproj." />
  </Target>

  <ItemGroup Condition="'$(ProDir)' != ''">
    <ProjectReference Include="$(ProDir)/src/Verbara.Sdk.Pro.Licensing/Verbara.Sdk.Pro.Licensing.csproj" />
  </ItemGroup>

</Project>

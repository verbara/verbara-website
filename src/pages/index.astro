---
import Layout from '../layouts/Layout.astro';
import { getMessages } from '../i18n/messages';
import { getLocaleFromPath, localiseHref } from '../i18n/utils';
import Button from '../components/primitives/Button.astro';
import Badge from '../components/primitives/Badge.astro';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getMessages(locale);
---

<Layout>
  <section class="px-6 py-20 text-center">
    <div class="mx-auto max-w-3xl space-y-6">
      <Badge variant="mono">MIT SDK · Apache Platform · 0 vulns</Badge>
      <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-balance">
        {t.landing.hero_title}
      </h1>
      <p class="text-xl opacity-80 text-balance">
        {t.landing.hero_subtitle}
      </p>
      <div class="flex flex-wrap justify-center gap-3 pt-4">
        <Button variant="primary" size="lg" href={localiseHref('developer-license', locale)}>
          {t.landing.cta_developer}
        </Button>
        <a
          href={localiseHref('pricing', locale)}
          class="inline-flex items-center justify-center rounded-md border border-[var(--color-fg)]/20 px-5 py-2.5 text-sm font-medium hover:bg-[var(--color-fg)]/5"
        >
          {t.landing.cta_pricing}
        </a>
      </div>
    </div>
  </section>

  <section class="px-6 py-16 border-t border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-5xl space-y-10">
      <header class="space-y-3 text-center">
        <h2 class="text-3xl font-semibold">{t.landing.why_title}</h2>
        <p class="text-lg opacity-70 max-w-2xl mx-auto text-balance">
          {t.landing.why_subtitle}
        </p>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        <article class="rounded-lg border border-black/5 dark:border-white/10 p-6 space-y-2">
          <h3 class="text-lg font-semibold">{t.landing.why_b1_title}</h3>
          <p class="text-sm opacity-80 leading-relaxed">{t.landing.why_b1_body}</p>
        </article>
        <article class="rounded-lg border border-black/5 dark:border-white/10 p-6 space-y-2">
          <h3 class="text-lg font-semibold">{t.landing.why_b2_title}</h3>
          <p class="text-sm opacity-80 leading-relaxed">{t.landing.why_b2_body}</p>
        </article>
        <article class="rounded-lg border border-black/5 dark:border-white/10 p-6 space-y-2">
          <h3 class="text-lg font-semibold">{t.landing.why_b3_title}</h3>
          <p class="text-sm opacity-80 leading-relaxed">{t.landing.why_b3_body}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="px-6 py-16 border-t border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-5xl space-y-8">
      <header class="space-y-3 text-center">
        <h2 class="text-3xl font-semibold">{t.landing.stack_title}</h2>
        <p class="opacity-70 max-w-2xl mx-auto text-balance">{t.landing.stack_subtitle}</p>
      </header>
      <div class="overflow-x-auto rounded-lg border border-black/5 dark:border-white/10">
        <table class="w-full text-sm">
          <thead class="bg-black/5 dark:bg-white/5">
            <tr>
              <th class="text-left px-4 py-3 font-medium">Repository</th>
              <th class="text-left px-4 py-3 font-medium">License</th>
              <th class="text-left px-4 py-3 font-medium">Role</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-black/5 dark:divide-white/10">
            <tr>
              <td class="px-4 py-3 font-medium"><a href="https://github.com/verbara/Verbara.Sdk" class="hover:underline">Verbara Sdk</a></td>
              <td class="px-4 py-3"><span class="rounded bg-emerald-100 dark:bg-emerald-900 px-2 py-0.5 text-xs">MIT</span></td>
              <td class="px-4 py-3 opacity-80">{t.landing.stack_role_sdk}</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium">Verbara Web</td>
              <td class="px-4 py-3"><span class="rounded bg-blue-100 dark:bg-blue-900 px-2 py-0.5 text-xs">Apache 2.0</span></td>
              <td class="px-4 py-3 opacity-80">{t.landing.stack_role_web}</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium">Verbara Platform</td>
              <td class="px-4 py-3"><span class="rounded bg-blue-100 dark:bg-blue-900 px-2 py-0.5 text-xs">Apache 2.0</span></td>
              <td class="px-4 py-3 opacity-80">{t.landing.stack_role_platform}</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium">Verbara Sdk Pro</td>
              <td class="px-4 py-3"><span class="rounded bg-amber-100 dark:bg-amber-900 px-2 py-0.5 text-xs">Commercial</span></td>
              <td class="px-4 py-3 opacity-80">{t.landing.stack_role_pro}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>

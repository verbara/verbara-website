---
import Layout from '../../../layouts/Layout.astro';
import Section from '../../../components/primitives/Section.astro';
import Container from '../../../components/primitives/Container.astro';
import Heading from '../../../components/primitives/Heading.astro';
import { getMessages } from '../../../i18n/messages';
import { getLocaleFromPath } from '../../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'en-US' } }, { params: { lang: 'pt-BR' } }];
}

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getMessages(locale);
---

<Layout title={`${t.legal_terms.title} — ${t.meta.site_title}`}>
  <Section>
    <Container size="sm">
      <div class="space-y-6">
        <Heading level={1}>{t.legal_terms.title}</Heading>
        <p class="text-base text-bone-2 leading-relaxed">{t.legal_terms.body}</p>
      </div>
    </Container>
  </Section>
</Layout>

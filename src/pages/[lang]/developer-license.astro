---
import Layout from '../../layouts/Layout.astro';
import { getMessages } from '../../i18n/messages';
import { getLocaleFromPath } from '../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'en-US' } }, { params: { lang: 'pt-BR' } }];
}

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getMessages(locale);
---

<Layout title={`${t.developer_license.title} — ${t.meta.site_title}`}>
  <section class="px-6 py-20">
    <div class="mx-auto max-w-2xl space-y-8">
      <header class="space-y-3 text-center">
        <h1 class="text-4xl font-bold tracking-tight">{t.developer_license.title}</h1>
        <p class="text-lg opacity-80">{t.developer_license.subtitle}</p>
      </header>

      <div
        class="rounded-lg border border-amber-200 bg-amber-50 dark:border-amber-900 dark:bg-amber-950 p-6 space-y-4"
        role="alert"
      >
        <h2 class="text-base font-semibold">{t.developer_license.coming_soon_title}</h2>
        <p class="text-sm leading-relaxed">{t.developer_license.coming_soon_body}</p>
        <a
          href="mailto:licensing@verbara.io"
          class="inline-flex items-center justify-center rounded-md bg-[var(--color-fg)] text-[var(--color-bg)] px-4 py-2 text-sm font-medium hover:opacity-90"
        >
          {t.developer_license.contact_label}
        </a>
      </div>
    </div>
  </section>
</Layout>

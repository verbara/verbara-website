---
import Layout from '../layouts/Layout.astro';
import Section from '../components/primitives/Section.astro';
import Container from '../components/primitives/Container.astro';
import Heading from '../components/primitives/Heading.astro';
import DeveloperLicenseForm from '../components/DeveloperLicenseForm.astro';
import { getMessages } from '../i18n/messages';
import { getLocaleFromPath } from '../i18n/utils';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getMessages(locale);
---

<Layout title={`${t.developer_license.title} — ${t.meta.site_title}`}>
  <Section>
    <Container size="sm">
      <div class="space-y-8">
        <div class="space-y-3 text-center">
          <Heading level={1} align="center">{t.developer_license.title}</Heading>
          <p class="text-lg text-bone-2">{t.developer_license.subtitle}</p>
        </div>
        <DeveloperLicenseForm />
      </div>
    </Container>
  </Section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import DeveloperLicenseForm from '../components/DeveloperLicenseForm.astro';
import { getMessages } from '../i18n/messages';
import { getLocaleFromPath } from '../i18n/utils';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getMessages(locale);
---

<Layout title={`${t.developer_license.title} — ${t.meta.site_title}`}>
  <section class="px-6 py-16">
    <div class="mx-auto max-w-3xl space-y-8">
      <header class="space-y-3 text-center">
        <h1 class="text-4xl font-bold tracking-tight">{t.developer_license.title}</h1>
        <p class="text-lg opacity-80">{t.developer_license.subtitle}</p>
      </header>
      <DeveloperLicenseForm />
    </div>
  </section>
</Layout>

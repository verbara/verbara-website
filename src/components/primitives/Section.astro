---
interface Props {
  id?: string;
  tone?: 'default' | 'inset';
  class?: string;
}
const { id, tone = 'default', class: extra = '' } = Astro.props;
const tones: Record<NonNullable<Props['tone']>, string> = {
  default: '',
  inset: 'bg-ink-3',
};
const cls = ['py-20 md:py-28', tones[tone], extra].filter(Boolean).join(' ');
---

<section id={id} class={cls}><slot /></section>

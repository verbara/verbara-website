---
import TierCard from './TierCard.astro';
import type { TierId, CtaKind, BadgeKind } from './pricing-types';

interface TierItem {
  tierId: TierId;
  cta: CtaKind;
  badge?: BadgeKind;
}

interface Props {
  label: string;
  anchorId: string;
  tiers: TierItem[];
}

const { label, anchorId, tiers } = Astro.props;
---

<div id={anchorId} class="space-y-5 scroll-mt-24">
  <h3 class="text-xs font-mono uppercase tracking-wider text-amber">
    {label}
  </h3>

  <div
    class:list={[
      'grid gap-5',
      tiers.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3',
    ]}
  >
    {tiers.map((tier) => (
      <TierCard
        tierId={tier.tierId}
        cta={tier.cta}
        badge={tier.badge ?? null}
      />
    ))}
  </div>
</div>

---
import { getMessages } from '../i18n/messages';
import { getLocaleFromPath } from '../i18n/utils';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getMessages(locale);

// Public env vars (set in Cloudflare Pages dashboard or .env.local for dev).
// When PUBLIC_TURNSTILE_SITE_KEY is unset, render the coming-soon state instead
// of the form. When PUBLIC_ISSUER_URL is unset, default to a same-origin path
// (works once Phase 3's Pages Function lands at /api/developer-license).
const turnstileSiteKey =
  (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined) ?? '';
const issuerUrl =
  (import.meta.env.PUBLIC_ISSUER_URL as string | undefined) ??
  '/api/developer-license';
const formEnabled = turnstileSiteKey !== '';

const errorStrings = {
  email_invalid: t.developer_license.error_email_invalid,
  fullName_required: t.developer_license.error_fullName_required,
  eula_required: t.developer_license.error_eula_required,
  captcha_required: t.developer_license.error_captcha_required,
  rate_limited: t.developer_license.error_rate_limited,
  service_unavailable: t.developer_license.error_service_unavailable,
  generic: t.developer_license.error_generic,
};
const stateStrings = {
  submitting: t.developer_license.state_submitting,
  success_title: t.developer_license.state_success_title,
  success_body_html: t.developer_license.state_success_body_html,
};
---

{
  !formEnabled ? (
    <div
      class="rounded-lg border border-amber-200 bg-amber-50 dark:border-amber-900 dark:bg-amber-950 p-6 space-y-4"
      role="alert"
      data-testid="devlic-coming-soon"
    >
      <h2 class="text-base font-semibold">{t.developer_license.coming_soon_title}</h2>
      <p class="text-sm leading-relaxed">{t.developer_license.coming_soon_body}</p>
      <a
        href="mailto:licensing@verbara.io"
        class="inline-flex items-center justify-center rounded-md bg-[var(--color-fg)] text-[var(--color-bg)] px-4 py-2 text-sm font-medium hover:opacity-90"
      >
        {t.developer_license.contact_label}
      </a>
    </div>
  ) : (
    <div class="grid gap-8 md:grid-cols-[1fr_18rem]">
      <form
        id="devlic-form"
        novalidate
        data-issuer-url={issuerUrl}
        data-error-strings={JSON.stringify(errorStrings)}
        data-state-strings={JSON.stringify(stateStrings)}
        class="space-y-5"
      >
        <div class="space-y-1.5">
          <label for="devlic-email" class="block text-sm font-medium">
            {t.developer_license.form_email_label} <span class="text-red-500">*</span>
          </label>
          <input
            id="devlic-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={t.developer_license.form_email_placeholder}
            class="w-full rounded-md border border-black/15 dark:border-white/15 bg-transparent px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-fg)]"
            aria-describedby="devlic-email-error"
          />
          <p id="devlic-email-error" class="text-xs text-red-600 hidden" role="alert"></p>
        </div>

        <div class="space-y-1.5">
          <label for="devlic-fullName" class="block text-sm font-medium">
            {t.developer_license.form_fullName_label} <span class="text-red-500">*</span>
          </label>
          <input
            id="devlic-fullName"
            name="fullName"
            type="text"
            required
            autocomplete="name"
            placeholder={t.developer_license.form_fullName_placeholder}
            class="w-full rounded-md border border-black/15 dark:border-white/15 bg-transparent px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-fg)]"
            aria-describedby="devlic-fullName-error"
          />
          <p id="devlic-fullName-error" class="text-xs text-red-600 hidden" role="alert"></p>
        </div>

        <div class="space-y-1.5">
          <label for="devlic-company" class="block text-sm font-medium">
            {t.developer_license.form_company_label}
          </label>
          <input
            id="devlic-company"
            name="company"
            type="text"
            autocomplete="organization"
            placeholder={t.developer_license.form_company_placeholder}
            class="w-full rounded-md border border-black/15 dark:border-white/15 bg-transparent px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-fg)]"
          />
        </div>

        <div class="space-y-1.5">
          <label for="devlic-useCase" class="block text-sm font-medium">
            {t.developer_license.form_useCase_label}
          </label>
          <textarea
            id="devlic-useCase"
            name="useCase"
            rows="3"
            placeholder={t.developer_license.form_useCase_placeholder}
            class="w-full rounded-md border border-black/15 dark:border-white/15 bg-transparent px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-fg)] resize-y"
          ></textarea>
        </div>

        <div class="space-y-1.5">
          <label class="flex items-start gap-2 text-sm">
            <input
              id="devlic-eula"
              name="eulaAccepted"
              type="checkbox"
              required
              class="mt-0.5"
              aria-describedby="devlic-eula-error"
            />
            <span>
              {t.developer_license.form_eula_label}
            </span>
          </label>
          <p id="devlic-eula-error" class="text-xs text-red-600 hidden" role="alert"></p>
        </div>

        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="flexible"></div>
        <p id="devlic-captcha-error" class="text-xs text-red-600 hidden" role="alert"></p>

        <div
          id="devlic-form-error"
          class="hidden rounded-md border border-red-200 bg-red-50 dark:border-red-900 dark:bg-red-950 p-3 text-sm text-red-700 dark:text-red-200"
          role="alert"
        ></div>

        <button
          id="devlic-submit"
          type="submit"
          class="inline-flex w-full items-center justify-center rounded-md bg-[var(--color-fg)] text-[var(--color-bg)] px-4 py-2.5 text-sm font-medium hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          {t.developer_license.form_submit}
        </button>
      </form>

      <aside class="space-y-3 text-sm">
        <h2 class="text-base font-semibold">
          {t.developer_license.what_you_get_title}
        </h2>
        <ul class="space-y-2 opacity-80">
          <li class="flex gap-2">
            <span class="opacity-50" aria-hidden>·</span>
            <span>{t.developer_license.what_you_get_agents}</span>
          </li>
          <li class="flex gap-2">
            <span class="opacity-50" aria-hidden>·</span>
            <span>{t.developer_license.what_you_get_node}</span>
          </li>
          <li class="flex gap-2">
            <span class="opacity-50" aria-hidden>·</span>
            <span>{t.developer_license.what_you_get_duration}</span>
          </li>
          <li class="flex gap-2">
            <span class="opacity-50" aria-hidden>·</span>
            <span>{t.developer_license.what_you_get_features}</span>
          </li>
          <li class="flex gap-2">
            <span class="opacity-50" aria-hidden>·</span>
            <span>{t.developer_license.what_you_get_mode}</span>
          </li>
        </ul>
      </aside>
    </div>
  )
}

{
  formEnabled && (
    <Fragment>
      <output
        id="devlic-success"
        class="hidden block rounded-lg border border-emerald-200 bg-emerald-50 dark:border-emerald-900 dark:bg-emerald-950 p-6 mt-6"
        data-testid="devlic-success"
      >
        <h2 class="text-base font-semibold">{t.developer_license.state_success_title}</h2>
        <p id="devlic-success-body" class="mt-2 text-sm leading-relaxed"></p>
      </output>

      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
      ></script>

      <script>
        type ErrorStrings = {
          email_invalid: string;
          fullName_required: string;
          eula_required: string;
          captcha_required: string;
          rate_limited: string;
          service_unavailable: string;
          generic: string;
        };
        type StateStrings = {
          submitting: string;
          success_title: string;
          success_body_html: string;
        };

        const form = document.getElementById('devlic-form') as HTMLFormElement | null;
        if (form) {
          const issuerUrl = form.dataset.issuerUrl ?? '/api/developer-license';
          const errors: ErrorStrings = JSON.parse(form.dataset.errorStrings ?? '{}');
          const states: StateStrings = JSON.parse(form.dataset.stateStrings ?? '{}');

          const submit = document.getElementById('devlic-submit') as HTMLButtonElement;
          const submitDefaultLabel = submit.textContent ?? '';
          const formError = document.getElementById('devlic-form-error') as HTMLElement;
          const successPanel = document.getElementById('devlic-success') as HTMLElement;
          const successBody = document.getElementById('devlic-success-body') as HTMLElement;

          const fieldError = (id: string, message: string | null) => {
            const el = document.getElementById(`devlic-${id}-error`);
            if (!el) return;
            if (message === null) {
              el.classList.add('hidden');
              el.textContent = '';
            } else {
              el.classList.remove('hidden');
              el.textContent = message;
            }
          };

          const showFormError = (message: string | null) => {
            if (message === null) {
              formError.classList.add('hidden');
              formError.textContent = '';
            } else {
              formError.classList.remove('hidden');
              formError.textContent = message;
            }
          };

          const escapeHtml = (s: string): string =>
            s
              .replaceAll('&', '&amp;')
              .replaceAll('<', '&lt;')
              .replaceAll('>', '&gt;')
              .replaceAll('"', '&quot;')
              .replaceAll("'", '&#39;');

          form.addEventListener('submit', async (event) => {
            event.preventDefault();

            (['email', 'fullName', 'eula', 'captcha'] as const).forEach((id) =>
              fieldError(id, null),
            );
            showFormError(null);

            const formData = new FormData(form);
            const email = String(formData.get('email') ?? '').trim();
            const fullName = String(formData.get('fullName') ?? '').trim();
            const company = String(formData.get('company') ?? '').trim();
            const useCase = String(formData.get('useCase') ?? '').trim();
            const eulaAccepted = formData.get('eulaAccepted') === 'on';
            const captchaToken = String(formData.get('cf-turnstile-response') ?? '');

            let valid = true;
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
              fieldError('email', errors.email_invalid);
              valid = false;
            }
            if (fullName.length === 0) {
              fieldError('fullName', errors.fullName_required);
              valid = false;
            }
            if (!eulaAccepted) {
              fieldError('eula', errors.eula_required);
              valid = false;
            }
            if (captchaToken.length === 0) {
              fieldError('captcha', errors.captcha_required);
              valid = false;
            }
            if (!valid) return;

            submit.disabled = true;
            submit.textContent = states.submitting;

            try {
              const response = await fetch(issuerUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  email,
                  fullName,
                  company: company === '' ? null : company,
                  useCase: useCase === '' ? null : useCase,
                  eulaAccepted: true,
                  captchaToken,
                }),
              });

              if (response.status === 202) {
                form.style.display = 'none';
                successPanel.classList.remove('hidden');
                successBody.innerHTML = states.success_body_html.replaceAll(
                  '{email}',
                  `<strong>${escapeHtml(email)}</strong>`,
                );
                return;
              }
              if (response.status === 429) {
                showFormError(errors.rate_limited);
                return;
              }
              if (response.status === 503 || response.status === 502) {
                showFormError(errors.service_unavailable);
                return;
              }
              showFormError(errors.generic);
            } catch {
              showFormError(errors.service_unavailable);
            } finally {
              submit.disabled = false;
              submit.textContent = submitDefaultLabel;
              const turnstile = (window as unknown as { turnstile?: { reset(): void } }).turnstile;
              if (turnstile) turnstile.reset();
            }
          });
        }
      </script>
    </Fragment>
  )
}
